# Copy to .env and fill in. Values set in the UI take precedence over these.
EMAIL_ADDRESS=you@gmail.com
# Gmail/Outlook app password (spaces optional). PASSWORD= also works.
EMAIL_APP_PASSWORD=abcdefghijklmnop

# AI model: set the key for whichever provider you pick in the UI (only one is needed)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
# For the "custom" provider:
LLM_API_KEY=

# Optional defaults when nothing is chosen in the UI
# LLM_PROVIDER=anthropic
# LLM_MODEL=
